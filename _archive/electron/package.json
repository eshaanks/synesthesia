{
  "name": "synesthesia",
  "version": "1.0.0",
  "description": "Live voice art installation",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac --x64 --arm64",
    "build:win": "electron-builder --win --x64",
    "build:all": "electron-builder --mac --win --x64"
  },
  "build": {
    "appId": "com.synesthesia.app",
    "productName": "Synesthesia",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "../client/**/*"
    ],
    "extraFiles": [],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "icon": "../assets/icon.icns"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "../assets/icon.ico"
    },
    "dmg": {
      "title": "Synesthesia Installer",
      "background": "../assets/dmg-bg.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
